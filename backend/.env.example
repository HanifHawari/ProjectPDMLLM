# Salin ke backend/.env untuk pengembangan lokal. Jangan commit file .env atau token asli.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database lokal; jalankan backend dari folder backend/.
DATABASE_URL=sqlite:///./fitmind.db
DATASET_BASE_PATH=../dataset
CHROMA_PERSIST_DIR=./chroma_db

# Isi SESSION_SECRET dengan nilai acak yang panjang sebelum memakai akun.
SESSION_SECRET=

# Kunci layanan opsional untuk fitur terkait.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RAPIDAPI_KEY=
FONNTE_TOKEN=
